{
  "name": "@zurupos/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:rls": "dotenv -e ../../.env -- vitest run test/rls",
    "db:types": "dotenv -e ../../.env -- sh -c 'kysely-codegen --dialect postgres --url \"$MIGRATION_DATABASE_URL\" --out-file src/db/types.ts --exclude-pattern schema_migrations --date-parser string --type-mapping \"{\\\"int8\\\":\\\"bigint\\\"}\" && prettier --write src/db/types.ts'",
    "openapi": "dotenv -e ../../.env -- tsx scripts/openapi.ts",
    "worker": "dotenv -e ../../.env -- tsx watch src/worker/worker.ts",
    "seed": "dotenv -e ../../.env -- tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
