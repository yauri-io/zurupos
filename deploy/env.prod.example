# ZuruPOS production settings (docs/DEPLOY.md). On the server:
#   cp deploy/env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# then fill in every value. deploy/.env.prod is gitignored; never commit it.
# Generate each password with: openssl rand -base64 32 | tr -d '/+='

# --- Domains (Cloudflare DNS, proxied) ---
APP_DOMAIN=app.zurupos.com
API_DOMAIN=api.zurupos.com
# Landing page (apps/landing); www. redirects to it.
SITE_DOMAIN=zurupos.com
# Host port Caddy listens on. Cloudflare's Origin Rule forwards to it.
HTTPS_PORT=9443

# --- Postgres (all different, all random) ---
POSTGRES_PASSWORD=
ZURU_MIGRATOR_PASSWORD=
ZURU_APP_PASSWORD=
ZURU_WORKER_PASSWORD=
# Max connections in the API pool.
DATABASE_POOL_MAX=10

# --- API ---
# trace | debug | info | warn | error
LOG_LEVEL=info
# Turn on only while creating the pilot shop's account, then off again (D-017).
SIGNUP_ENABLED=false

# --- Login bot check: Cloudflare Turnstile (D-064, DEPLOY.md "Login bot check") ---
# Both empty: no check. Both set: the dashboard login needs a passed challenge.
# Never set only one: a secret without a site key locks every owner out.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Resend; the sending domain must be verified in Resend) ---
EMAIL_PROVIDER=resend
EMAIL_FROM="ZuruPOS <no-reply@zurupos.com>"
RESEND_API_KEY=
# Outbox worker poll interval in ms (SPEC §10).
WORKER_POLL_MS=5000

# --- Error reporting: Sentry (D-053, DEPLOY.md "Error reporting") ---
# Leave empty to keep Sentry off. API and worker share one DSN; the dashboard
# has its own project.
SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
# Optional. Leave empty: errors are then tagged with the build version that
# deploy/prod.sh computes from git (ZURU_VERSION, D-057).
SENTRY_RELEASE=

# --- Backups (backup service) ---
# Host directory for the nightly dumps, relative to deploy/.
BACKUP_DIR=./backups
# Daily backup time (HHMM) in BACKUP_TZ, and how many days of dumps to keep.
BACKUP_AT=0300
BACKUP_TZ=Asia/Jakarta
BACKUP_KEEP_DAYS=14

# --- Off-site copy of the dumps: Cloudflare R2 (D-052, DEPLOY.md "Backups") ---
# Leave R2_BUCKET empty to keep the dumps on the server only.
R2_BUCKET=
# https://<account id>.r2.cloudflarestorage.com : the host only. Cloudflare shows
# the S3 URL with /<bucket> on the end; leave that off.
R2_ENDPOINT=
# An R2 API token with "Object Read & Write" on this bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Backup monitor (optional) ---
# A dead-man's-switch URL (e.g. healthchecks.io). Pinged after every good
# backup, and with /fail appended after a failed one.
BACKUP_PING_URL=
