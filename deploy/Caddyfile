# ZuruPOS behind Cloudflare (D-049). Cloudflare terminates public TLS and
# forwards to this Caddy on HTTPS_PORT (an Origin Rule rewrites the port). Caddy
# serves a Cloudflare origin certificate from ./certs, so it needs no ACME and
# no host ports 80/443 (those belong to another stack on the VPS).
#
# CF_RANGES is only set by the local rehearsal (compose.rehearsal.yml); in
# production the Cloudflare ranges below apply. Refresh them from
# https://www.cloudflare.com/ips when they change.
{
	auto_https off
	servers {
		trusted_proxies static {$CF_RANGES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
		client_ip_headers CF-Connecting-IP
	}
}

(common) {
	# Docker publishes the port past the host firewall, so drop anything that
	# doesn't come from Cloudflare here.
	@not_cloudflare not remote_ip {$CF_RANGES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
	abort @not_cloudflare

	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip

	log {
		output stdout
		format json
	}
}

# Owner dashboard (SPA served by the Nuxt server).
{$APP_DOMAIN} {
	import common

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://{$API_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Overwrite, never append: Cloudflare passes client-supplied XFF values on.
	reverse_proxy dashboard:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# API for the dashboard and the cashier app. Helmet sets the API's own headers.
{$API_DOMAIN} {
	import common

	header -Server

	# The API trusts X-Forwarded-For (TRUST_PROXY) for its rate limits, so it
	# must carry only the client IP Caddy derived from CF-Connecting-IP.
	reverse_proxy api:4000 {
		header_up X-Forwarded-For {client_ip}
	}
}
