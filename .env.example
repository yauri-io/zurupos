# ZuruPOS local development environment. Copy to `.env`: cp .env.example .env
# Every variable the stack reads is documented here. Values below are
# development-only placeholders; never reuse them anywhere else.

# --- Postgres container (docker-compose) ---
# Host port for the dev Postgres (5432 is often taken by a local install).
POSTGRES_PORT=55432
# Superuser password for the postgres container. Used by db/init, and by the
# role-guard test to prove the API refuses to start as a superuser.
POSTGRES_PASSWORD=dev_superuser
# Passwords for the login roles created by db/init/00-roles.sh (D-014).
ZURU_MIGRATOR_PASSWORD=dev_migrator
ZURU_APP_PASSWORD=dev_app
ZURU_WORKER_PASSWORD=dev_worker

# --- Connection strings used from the host ---
# Migrations: dbmate connects as zuru_migrator (becomes zuru_owner).
MIGRATION_DATABASE_URL=postgres://zuru_migrator:dev_migrator@localhost:55432/zuru?sslmode=disable
TEST_MIGRATION_DATABASE_URL=postgres://zuru_migrator:dev_migrator@localhost:55432/zuru_test?sslmode=disable
# API runtime: always zuru_app (never a superuser or table owner).
DATABASE_URL=postgres://zuru_app:dev_app@localhost:55432/zuru
# Integration tests: zuru_app on the separate test database.
TEST_DATABASE_URL=postgres://zuru_app:dev_app@localhost:55432/zuru_test
# Outbox worker role (used from M3).
WORKER_DATABASE_URL=postgres://zuru_worker:dev_worker@localhost:55432/zuru
TEST_WORKER_DATABASE_URL=postgres://zuru_worker:dev_worker@localhost:55432/zuru_test
# Max connections in the API pool.
DATABASE_POOL_MAX=10

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# trace | debug | info | warn | error
LOG_LEVEL=info
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Exact origin of the dashboard (CORS + CSRF same-origin check).
DASHBOARD_ORIGIN=http://localhost:3000
# Public URL of the dashboard, used for links in emails.
DASHBOARD_URL=http://localhost:3000
# Dashboard session cookie `Secure` flag. Keep true outside local http dev (D-021).
COOKIE_SECURE=false
# Allow POST /v1/auth/signup (D-017). Keep false in production pilot.
SIGNUP_ENABLED=true

# --- Email (SPEC §10) ---
# smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="ZuruPOS <no-reply@zurupos.local>"
# Mailpit in docker-compose catches all mail: http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Only needed when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# --- Dashboard (Nuxt) ---
# Base URL the dashboard uses to call the API.
NUXT_PUBLIC_API_BASE=http://localhost:4000
