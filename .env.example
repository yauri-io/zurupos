# ZuruPOS local development environment. Copy to `.env`: cp .env.example .env
# Every variable the stack reads is documented here. Values below are
# development-only placeholders; never reuse them anywhere else.

# --- Postgres container (docker-compose) ---
# Host port for the dev Postgres (5432 is often taken by a local install).
POSTGRES_PORT=55432
# Superuser password for the postgres container. Used by db/init, and by the
# role-guard test to prove the API refuses to start as a superuser.
POSTGRES_PASSWORD=dev_superuser
# Passwords for the login roles created by db/init/00-roles.sh (D-014).
ZURU_MIGRATOR_PASSWORD=dev_migrator
ZURU_APP_PASSWORD=dev_app
ZURU_WORKER_PASSWORD=dev_worker

# --- Connection strings used from the host ---
# Migrations: dbmate connects as zuru_migrator (becomes zuru_owner).
MIGRATION_DATABASE_URL=postgres://zuru_migrator:dev_migrator@localhost:55432/zuru?sslmode=disable
TEST_MIGRATION_DATABASE_URL=postgres://zuru_migrator:dev_migrator@localhost:55432/zuru_test?sslmode=disable
# API runtime: always zuru_app (never a superuser or table owner).
DATABASE_URL=postgres://zuru_app:dev_app@localhost:55432/zuru
# Integration tests: zuru_app on the separate test database.
TEST_DATABASE_URL=postgres://zuru_app:dev_app@localhost:55432/zuru_test
# Outbox worker role (used from M3).
WORKER_DATABASE_URL=postgres://zuru_worker:dev_worker@localhost:55432/zuru
TEST_WORKER_DATABASE_URL=postgres://zuru_worker:dev_worker@localhost:55432/zuru_test
# Outbox worker poll interval in ms (SPEC §10: 5 s).
WORKER_POLL_MS=5000
# Report email scheduler (SPEC §12.6): connects as zuru_app (DATABASE_URL) and
# uses DASHBOARD_URL for links. How often it checks what's due, in ms (5 min).
SCHEDULER_POLL_MS=300000
# Max connections in the API pool.
DATABASE_POOL_MAX=10

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# trace | debug | info | warn | error
LOG_LEVEL=info
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Exact origin of the dashboard (CORS + CSRF same-origin check).
DASHBOARD_ORIGIN=http://localhost:3000
# Public URL of the dashboard, used for links in emails.
DASHBOARD_URL=http://localhost:3000
# Dashboard session cookie `Secure` flag. Keep true outside local http dev (D-021).
COOKIE_SECURE=false
# Allow POST /v1/auth/signup (D-017). Keep false in production pilot.
SIGNUP_ENABLED=true

# --- Login bot check: Cloudflare Turnstile (D-064) ---
# Leave both empty to turn it off (the default; the API tests never call Cloudflare).
# Set both, or neither: a secret without a site key refuses every dashboard login.
# To try it locally, use Cloudflare's test keys, which always pass:
#   NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Email (SPEC §10) ---
# smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="ZuruPOS <no-reply@zurupos.local>"
# Mailpit in docker-compose catches all mail: http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Mailpit's HTTP API, used by the worker test to check delivered mail.
MAILPIT_API_URL=http://localhost:8025
# Only needed when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# --- Online menu (SPEC §12.7, D-079, D-080) ---
# Where uploaded photos go: local | s3. Local dev and tests use `local`; production
# uses `s3` with a Cloudflare R2 bucket (separate from the backups bucket).
MEDIA_DRIVER=local
# Folder for `local`: the API writes the WebP variants here and serves them under
# /media/*. Relative paths are relative to the API's working directory (apps/api).
MEDIA_LOCAL_DIR=./var/media
# Public base URL of the variants (no trailing slash); an image is
# <MEDIA_PUBLIC_BASE_URL>/m/<key>-<size>.webp. Local: the API itself.
# Production: the R2 bucket's custom domain, https://media.zurupos.com.
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
# Only for MEDIA_DRIVER=s3. Endpoint without the bucket, e.g. R2's
# https://<account-id>.r2.cloudflarestorage.com; the key needs object read and write on the bucket.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Base of the public menu address; the link and QR code are <base>/<slug>.
# Local: the menu app (O2) on :3001. Production: https://menu.zurupos.com.
MENU_PUBLIC_BASE_URL=http://localhost:3001

# --- Dashboard (Nuxt) ---
# Base URL the dashboard uses to call the API.
NUXT_PUBLIC_API_BASE=http://localhost:4000

# --- Public online menu app (apps/menu, SPEC §12.7) ---
# Only needed to run it on the host (`pnpm --filter @zurupos/menu dev`, :3001);
# the defaults below match local dev, and docker-compose sets them for the
# `menu` service. The API over the network it can reach:
# NUXT_API_INTERNAL_BASE=http://localhost:4000
# The menu's own base (canonical/og:url); same value as MENU_PUBLIC_BASE_URL:
# NUXT_PUBLIC_SITE_URL=http://localhost:3001
# For the page's CSP img-src; same value as MEDIA_PUBLIC_BASE_URL:
# NUXT_MEDIA_BASE_URL=http://localhost:4000/media
# Where "Menu oleh ZuruPOS" and the bare menu domain point:
# NUXT_PUBLIC_LANDING_URL=https://zurupos.com

# --- Error reporting: Sentry (D-053) ---
# Leave the DSNs empty to keep Sentry off (the default for local dev and tests).
# API + outbox worker (a Node project in Sentry).
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Optional. Defaults to ZURU_VERSION when that is set.
SENTRY_RELEASE=
# Dashboard (a Vue project in Sentry). The DSN is public by design.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
NUXT_PUBLIC_SENTRY_RELEASE=
# Build version shown in the dashboard and /healthz (D-057). Leave unset: local
# builds are 'dev', and deploy/prod.sh bakes it into the production images from git.
# ZURU_VERSION=
# Cashier app: not an env var. Build with --dart-define=SENTRY_DSN=... (a Flutter
# project in Sentry); apps/cashier/tool/build_release.sh passes $SENTRY_DSN.
